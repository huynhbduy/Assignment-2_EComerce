<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewData["Title"] · Cổng đại lý</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" style="display:none">
<symbol id="box" viewBox="0 0 24 24"><path d="m3 7 9-5 9 5v10l-9 5-9-5z M3 7l9 5 9-5 M12 12v10 M7 5l10 5"/></symbol>
<symbol id="list" viewBox="0 0 24 24"><path d="M5 3h14v18H5z M8 8h8 M8 12h8 M8 16h5"/></symbol>
</svg>
<header><nav class="navbar container portalnav" aria-label="Điều hướng chính">
<span class="brand"><svg class="icon" aria-hidden="true"><use href="#box"/></svg> Cổng đại lý</span>
@if (User.Identity?.IsAuthenticated == true) {
<div class="navlinks">
<a asp-controller="Portal" asp-action="Catalog"><svg class="icon" aria-hidden="true"><use href="#box"/></svg> Hàng hóa</a>
<a asp-controller="Portal" asp-action="History"><svg class="icon" aria-hidden="true"><use href="#list"/></svg> Đơn của tôi</a>
</div>
<form asp-controller="Account" asp-action="Logout" method="post" class="account"><span>@User.Identity.Name</span><button class="btn btn-outline-light btn-sm">Đăng xuất</button></form>
}
</nav></header>
<main class="container">
@if (TempData["Error"] is string error) { <p class="alert alert-danger" role="alert">@error</p> }
@if (TempData["Success"] is string success) { <p class="alert alert-success" role="status">@success</p> }
@RenderBody()
</main></body></html>

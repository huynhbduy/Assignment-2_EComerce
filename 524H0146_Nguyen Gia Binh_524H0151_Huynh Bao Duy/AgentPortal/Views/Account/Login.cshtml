@model LoginInput
@{ ViewData["Title"]="Đăng nhập"; }
<section class="login surface">
<svg class="icon loginicon" aria-hidden="true"><use href="#box"/></svg>
<h1>Đăng nhập đại lý</h1>
<p class="muted">Đăng nhập để đặt hàng và theo dõi đơn đã gửi đến kho.</p>
<form asp-action="Login" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<label asp-for="UserName">Tên đăng nhập</label>
<input asp-for="UserName" class="form-control" autocomplete="username" maxlength="80" required autofocus>
<label asp-for="Password">Mật khẩu</label>
<input asp-for="Password" class="form-control" type="password" autocomplete="current-password" maxlength="512" required>
<button class="btn btn-primary w-100 mt-4">Đăng nhập</button>
</form></section>
